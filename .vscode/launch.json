{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前 C 文件 (CodeLLDB / lldb)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/${fileBasenameNoExtension}",
      "args": [],
