{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前 C 文件 (gcc + gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "gcc: 编译当前文件",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "将反汇编风格设置为 Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "调试当前作业 (make 编译整个仓库)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/homework/${input:hwNameForDebug}/main",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/homework/${input:hwNameForDebug}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "make: 编译整个仓库",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "hwNameForDebug",
      "type": "promptString",
      "description": "要调试的作业目录名（homework/ 下），例如 hw01",
      "default": "hw01"
    }
  ]
}
